# Base URL for the backend API, including the "/api" path.
# Leave unset for local dev -- Vite's dev server proxies /api to
# http://localhost:8000 (see vite.config.ts). Required for production
# builds against a deployed backend, e.g.:
# VITE_API_BASE_URL=https://actuarial-risk-model-api.onrender.com/api
